// Builds supabase/0015_business_upgrade.sql: replaces every Business board row in Studio with the
// content in content/site.ts, and updates the business tagline, reply time and Erwin's quote.
// Run: node --experimental-strip-types --no-warnings scripts/generate-business-sql.mts
import { writeFileSync } from "node:fs";
import { site } from "../content/site.ts";
import { businessItems } from "./business-items.mts";

const json = (v: unknown) => `$j$${JSON.stringify(v)}$j$::jsonb`;
const text = (v: string) => `$t$${v}$t$`;

const positions = new Map<string, number>();
const rows = businessItems(site.business).map((it) => {
  const pos = positions.get(it.group) ?? 0;
  positions.set(it.group, pos + 1);
  return `('business', ${text(it.group)}, ${pos}, ${text(it.title)}, ${json(it.data)})`;
});
const erwin = site.testimonials.find((t) => t.name === "Erwin Natividad");

const sql = `-- Generated by scripts/generate-business-sql.mts from content/site.ts.
-- The business page upgrade: personal and business bundles with today's prices, the full process,
-- guarantees, case studies, the discovery-call agenda, add-ons and FAQ.
-- REPLACES every row on Studio's Business board. Run once in Supabase → SQL Editor.
begin;

delete from public.studio_items where board = 'business';

insert into public.studio_items (board, group_key, position, title, data)
values
  ${rows.join(",\n  ")};

update public.studio_items
set data = data || ${json({ tagline: site.tagline, replyTime: site.replyTime })}
where board = 'site' and group_key = 'profile';
${
  erwin
    ? `
update public.studio_items
set data = data || ${json({ quote: erwin.quote })}
where board = 'site' and group_key = 'testimonials' and title = ${text(erwin.name)};
`
    : ""
}
commit;
`;
writeFileSync(new URL("../supabase/0015_business_upgrade.sql", import.meta.url), sql);
console.log(`business: ${rows.length} rows`);
