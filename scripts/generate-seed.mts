// Builds supabase/0002_seed.sql from the content files, so Studio starts with everything
// already on the site. Run: node --experimental-strip-types scripts/generate-seed.mts
import { writeFileSync } from "node:fs";
import { projects } from "../content/projects.ts";
import { site } from "../content/site.ts";
import { stampDefs } from "../content/stamps.ts";
import { privacy, terms } from "../content/legal.ts";
import { businessItems } from "./business-items.mts";

const json = (v: unknown) => `$j$${JSON.stringify(v)}$j$::jsonb`;
const text = (v: string | undefined | null) => (v == null ? "null" : `$t$${v}$t$`);
const arr = (v: string[]) => `array[${v.map((x) => text(x)).join(", ")}]::text[]`;

// Newest first, matching how the site ordered them before Studio
const ordered = [...projects].sort((a, b) => b.year - a.year);
const projectRows = ordered.map((p, i) =>
  `(${[
    text(p.slug), i, "true", text(p.name), text(p.kind), text(p.category), arr(p.tags), arr(p.stamps), p.year,
    text(p.years), text(p.roleShort), text(p.role), text(p.platform), text(p.status), text(p.liveUrl ?? null),
    text(p.docsUrl ?? null), text(p.designSystemUrl ?? null), json(p.screenshots), json(p.facts), json(p.stats), json(p.entries),
  ].join(", ")})`,
);

type Item = { board: "business" | "site"; group: string; title: string; data: unknown };
const items: Item[] = [];
const add = (board: Item["board"], group: string, title: string, data: unknown = {}) => items.push({ board, group, title, data });

// Site & About
add("site", "profile", "Profile", {
  name: site.name, role: site.role, location: site.location, email: site.email, replyTime: site.replyTime,
  tagline: site.tagline, calendlyUrl: site.calendlyUrl, resumeUrl: site.resumeUrl ?? "", heroLine: site.heroLine,
  hostTeaser: site.hostTeaser, inTheWorks: site.inTheWorks, enterprise: site.enterprise,
});
site.story.forEach((body, i) => add("site", "story", `Story, part ${i + 1}`, { body }));
add("site", "karinderya", "What a karinderya taught me", { body: site.karinderya });
site.interests.forEach((t) => add("site", "interests", t));
site.houseRules.forEach((r) => add("site", "house-rules", r.title, { body: r.body }));
site.tools.forEach((g) => add("site", "tools", g.group, { items: g.items }));
site.testimonials.forEach((t) => add("site", "testimonials", t.name, { title: t.title, year: t.year, quote: t.quote }));
site.socials.forEach((s) => add("site", "socials", s.label, { url: s.url }));
site.gallery.forEach((g) => add("site", "gallery", g.title, { date: g.date, category: g.category ?? "", src: g.src ?? "" }));
stampDefs.forEach((s) => add("site", "niches", s.label, { id: s.id, motto: s.motto, shape: s.shape }));
add("site", "legal", privacy.title, { key: "privacy", ...privacy });
add("site", "legal", terms.title, { key: "terms", ...terms });

// Business
businessItems(site.business).forEach((it) => add("business", it.group, it.title, it.data));

const positions = new Map<string, number>();
const itemRows = items.map((it) => {
  const key = `${it.board}/${it.group}`;
  const pos = positions.get(key) ?? 0;
  positions.set(key, pos + 1);
  return `(${[text(it.board), text(it.group), pos, text(it.title), json(it.data)].join(", ")})`;
});

const sql = `-- Generated by scripts/generate-seed.mts from the content files. Run after 0001_studio.sql.
-- Only fills empty tables, so running it twice does nothing the second time.
do $seed$
begin
  if not exists (select 1 from public.studio_projects) then
    insert into public.studio_projects
      (slug, position, published, name, kind, category, tags, stamps, year, years, role_short, role, platform, status,
       live_url, docs_url, design_system_url, screenshots, facts, stats, entries)
    values
      ${projectRows.join(",\n      ")};
  end if;

  if not exists (select 1 from public.studio_items) then
    insert into public.studio_items (board, group_key, position, title, data)
    values
      ${itemRows.join(",\n      ")};
  end if;
end
$seed$;
`;
writeFileSync(new URL("../supabase/0002_seed.sql", import.meta.url), sql);
console.log(`seed: ${projectRows.length} projects, ${itemRows.length} items`);
