# Copy to .env.local. Values: Supabase → Project Settings → API (URL + anon key + service_role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: lets the contact and project forms save inquiries. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: emails you when an inquiry comes in (Resend).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
